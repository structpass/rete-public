# API のベース URL（backend の global prefix /api/v1 を含む）。
# 開発デフォルトはこの値。本番デプロイ時は必ず実 URL を設定すること（未設定だと localhost に接続を試みる）。
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# dev / start サーバーの listen ポート（開発統括ローカルは .env.local で上書き）
PORT=3000

# バックログタブが iframe 表示する instruction-board の URL（開発運用タブ・rete 独自）。
# 別プロセスのローカル開発ツール。未起動・未使用なら iframe は空表示になるだけで他機能に影響しない。
NEXT_PUBLIC_INSTRUCTION_BOARD_URL=http://127.0.0.1:3072

# struct-pass-reference frontend のオリジン。共通シェル「システム」タブの起動確認 probe が
# このオリジンへ no-cors fetch で到達確認するため、CSP connect-src への追加に使う（rete-files-0037）。
# backend の REFERENCE_APP_URL と必ず一致させること。未設定なら下記デフォルトを使う。
NEXT_PUBLIC_REFERENCE_APP_URL=http://localhost:3000
