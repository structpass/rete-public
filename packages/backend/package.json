{
  "name": "@rete/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Struct Rete バックエンド - NestJS API",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs}/**/*.ts\" --no-fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "pretest": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library prisma generate",
    "type-check": "tsc --noEmit",
    "prisma:generate": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "cross-env NODE_ENV=development ts-node prisma/seed.ts",
    "prisma:seed:build": "tsc prisma/seed.ts --outDir dist-seed --module commonjs --target ES2021 --moduleResolution node --esModuleInterop --skipLibCheck --experimentalDecorators --emitDecoratorMetadata --resolveJsonModule --noEmitOnError",
    "prisma:seed:prod": "node dist-seed/prisma/seed.js",
    "unlock-admin": "cross-env NODE_ENV=development ts-node prisma/unlock-admin.ts",
    "reset:e2e-fixtures": "cross-env NODE_ENV=development ts-node prisma/reset-e2e-fixtures.ts",
    "prisma:studio": "prisma studio",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.2",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.2",
    "@nestjs/passport": "^11.0.2",
    "@nestjs/platform-express": "^11.0.2",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.0.2",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.2.0",
    "prisma": "^6.2.0",
    "@rete/shared": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.2.1",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "jose": "^6.2.3",
    "magic-bytes.js": "1.13.1",
    "multer": "^2.4.0",
    "nest-oidc-provider": "^2.1.0",
    "nodemailer": "^10.0.13",
    "oidc-provider": "^8.5.1",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.0.2",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^8.0.1",
    "@types/oidc-provider": "^8.8.1",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "resetMocks": true,
    "restoreMocks": true,
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!.*(otplib|@otplib|@scure|@noble|htmlparser2|domhandler|domutils|dom-serializer|domelementtype|entities))",
      "shared[\\\\/]dist[\\\\/]"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.module.ts",
      "!**/main.ts",
      "!**/*.interface.ts",
      "!**/*.dto.ts",
      "!**/index.ts",
      "!**/dto/index.ts",
      "!**/__tests__/**"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "branches": 64,
        "functions": 61,
        "lines": 78,
        "statements": 78
      }
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
