# Copy this file to .env and fill in all required values.
# NEVER commit the actual .env file to version control.

# ============================================================
# Database (REQUIRED)
# ============================================================
# Replace <user>, <password> with real values. DB name defaults to `rete`.
#
# 接続プールの上限は URL のクエリで明示する（Prisma 既定に任せない）。未指定だと起動時に警告が出る
# （本番は起動を拒否する＝common/config/env-validation.ts の validateDatabasePoolLimits）。
#   connection_limit=5  … このプロセスの Prisma が張る最大接続数（2 vCPU 相当の 2*N+1）。上限が無いと
#                         DB 側の max_connections を食い潰す。
#   pool_timeout=20     … 通常クエリがプールの空きを待つ秒数。超えると Prisma が P2024 を投げ、
#                         PrismaExceptionFilter が 503 + Retry-After へ写像する（0＝無限待ちは拒否）。
#                         値は最長のトランザクション上限（reorder 系の 15 秒）より長く取る＝短いと、
#                         占有側が自分の上限に達する前に、無関係なリクエストが先に 503 になる。
#                         なお interactive transaction の接続待ちは本値ではなく maxWait
#                         （runInSerializableTransaction の既定 5 秒 / 対話保存は 2 秒）が先に切り、
#                         その時のコードは P2024 ではなく P2028（写像先は同じ 503 + Retry-After）。
# 注意（接続数の勘定）: 本番の session ストア（connect-pg-simple）は同じ URL で pg の別プールを張るが、
# conObject.max=5（SESSION_POOL_MAX・session-store.config.ts）で明示している。1 インスタンスの実消費は
# 5 + 5 = 10 まで見込むこと。インスタンスを増やす時は インスタンス数 ×（connection_limit + session プール）
# が DB の max_connections を超えないよう見直す。検査の適用範囲: アプリ本体の起動時（main.ts・本番は
# fail-fast / dev は警告）と seed（警告のみ）で、migrate は検査の hook 点が無いため適用範囲外
# （operational-policy §4・cmn-0347）。
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/rete?schema=public&connection_limit=5&pool_timeout=20"

# ============================================================
# Application
# ============================================================
PORT=3001
# 必須。production / development / test のいずれか（未設定・未知値は起動拒否）。
# 本番ハードニング（secret 検証・secure cookie・pg session ストア）の発火条件のため、
# 本番デプロイでは必ず production を設定する（設定し忘れると insecure 設定で起動しようとして fail-fast）。
NODE_ENV=development

# ============================================================
# File storage (File タブ・Phase FB)
# ============================================================
# ファイル実体の保存ルート（ローカル FS）。譲渡先が 1 台でそのまま動く素直な相対パス。
# 未設定なら ./storage/files（backend 起動 cwd 基準）。実体は StorageService 抽象越しに read/write し、
# 後で S3 等へ差し替える場合はストレージドライバ切替を別途定義する（operational-policy §3/§4）。
# FILE_STORAGE_ROOT="./storage/files"

# ============================================================
# Swagger (API docs)
# ============================================================
# Swagger は既定で非公開。開発時など公開したい場合のみ true を明示する。
SWAGGER_ENABLED=false

# ============================================================
# CORS
# ============================================================
# Comma-separated list of allowed origins.
# 未設定（コメントアウト）の場合は http://localhost:3000 のみ許可される。
# Rete の frontend オリジン。OIDC 未ログイン時のログイン画面リダイレクト先にも使われる（先頭の値）。
CORS_ORIGIN="http://localhost:3000"

# ref-0037: reference frontend が表示設定 API（/accounts/me/display-preference の1ルートのみ）を
# クロスオリジンで直接 fetch するための限定許可。CORS_ORIGIN（全API適用）には混ぜない
# （security-reviewer 指摘: グローバル allowlist に混ぜると reference 侵害時の blast radius が全APIに及ぶ）。
# main.ts の route-scoped middleware だけがこの値を見る。未設定なら当該ルートも CORS_ORIGIN のみで判定される。
# 開発統括ローカルの例（rete=3010/3011・reference frontend=3000）: CROSS_SERVICE_CORS_ORIGIN="http://localhost:3000"
# CROSS_SERVICE_CORS_ORIGIN=""

# ============================================================
# Authentication / Session
# ============================================================
# express-session の署名鍵。本番では 32 文字以上のランダム値が必須（起動時に検証・placeholder 検出で throw）。
# 未設定の dev は安全でない既定値にフォールバックする。
SESSION_SECRET="change-me-to-a-long-random-secret-min-32-chars"

# session ストアの選択（dev 用）。未設定/その他は MemoryStore、'pg' で connect-pg-simple（既存 PostgreSQL の session テーブル）に切替。
# 本番（NODE_ENV=production）は本値に関わらず常に pg 永続ストア。永続ストア未配線なら起動拒否。
# session テーブルは Prisma migration が作成済（createTableIfMissing:false）。DATABASE_URL を共用する。
# SESSION_STORE="pg"

# ログイン試行ロックアウト（H6 / brute-force 防御）。連続失敗回数とロック期限は Account 行（DB）に保持し、
# IP やインスタンスを変えても回避できない。閾値は任意（未設定なら既定 5 回 / 15 分で安全側に動く）。正の整数のみ採用。
# MAX_LOGIN_ATTEMPTS="5"
# LOGIN_LOCKOUT_MINUTES="15"

# ST-2-2 MFA/TOTP: 認証アプリ（TOTP）secret の at-rest 暗号鍵（AES-256-GCM）。
# hex 64 文字（= 32 byte）または base64 で 32 byte。生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 未設定なら MFA 機能は graceful degradation で無効化（503・アプリは起動・既存ログインは継続）。本番は KMS / secret manager 管理推奨。
MFA_TOTP_ENC_KEY="change-me-64-hex-chars-or-base64-32-bytes-for-aes-256-gcm-secret-encryption"

# e2e レート制限の素通し（cmn-0395・開発専用）。"true" にすると @nestjs/throttler のレート制限
# （全体 30req/60s・login 系の個別 5req/60s を含む）が素通しになり、e2e 通し実行が throttle 由来の
# 429 で落ちなくなる。アカウント凍結（login-lockout・別レイヤ）は素通しの対象外＝効き続ける。
# 本番（NODE_ENV=production）では無効（立てても効かない）。起動時に有効状態がログで警告される。
# e2e を走らせる手順は e2e/README.md §前提を参照。
# E2E_THROTTLE_BYPASS="true"

# ============================================================
# OIDC Provider (Rete = Identity Provider)
# ============================================================
# issuer。未設定時は http://localhost:<PORT>/api/v1/oidc。本番は公開 URL を設定する。
# OIDC_ISSUER="https://rete.example.com/api/v1/oidc"

# OIDC の interaction / session cookie 署名鍵（カンマ区切りで鍵 rotation 可）。本番必須・32 文字以上。
OIDC_COOKIE_KEYS="change-me-to-a-long-random-secret-min-32-chars"

# 署名鍵(JWKS)。本番必須。JSON 文字列（{"keys":[...]}）。
# 未設定の dev は起動時に RS256 鍵を自動生成する（プロセス再起動で失効＝dev 用）。
# OIDC_JWKS='{"keys":[ ... ]}'   # 素の配列 '[ ... ]' も可。鍵ゼロ・解釈不能な値は起動時に失敗する。

# ============================================================
# Seed（pnpm db:seed が読む初期アカウント）
# ============================================================
# 未設定なら admin@rete.local / 既定の公開パスワードで作成される。
# 譲渡先・共有環境では必ず設定し、既定値を使わないこと。
# 本番（NODE_ENV=production）では SEED_ADMIN_PASSWORD 未設定だと seed が停止する
# （既定の公開パスワードでの bootstrap admin 作成を拒否する fail-fast）。
# SEED_ADMIN_EMAIL="admin@rete.local"
# SEED_ADMIN_PASSWORD="set-a-strong-password-in-prod"
# SEED_DEMO_PASSWORD="set-a-strong-demo-password"
# bootstrap admin の固定 sub。reference 側 seed と一致させること。
# BOOTSTRAP_ADMIN_SUB="00000000-0000-4000-a000-000000000001"

# ============================================================
# OIDC Relying Party: struct-pass-reference 連携（次フェーズで本格使用）
# ============================================================
# Rete=IdP に対する RP（struct-pass-reference）。Hub の「システム」導線の遷移先にもなる。
# OIDC_REFERENCE_CLIENT_SECRET と OIDC_REFERENCE_REDIRECT_URIS を**両方**設定した時だけ静的 client が登録される
# （未設定の dev では client 0 件）。cmn-0230: dev 既定値は撤去済＝未設定なら RP 連携を使わず、起動もしない。
# 本番で CLIENT_SECRET 設定済みかつ REDIRECT_URIS 未設定だと起動時に明確なエラーで止まる
# （silent に localhost:3001 へ向かわせないための fail-closed）。
# 本番では redirect URI 値も形式（http/https）・localhost 宛でないことが検査される（cmn-0249）。
# dev/staging では CLIENT_SECRET 設定済＋REDIRECT_URIS 未設定で起動時 warn 1 行が出る。
# 既定値のまま本番に流出させないため、placeholder 値は使わずランダムな secret を設定すること。
# REFERENCE_APP_URL は reference frontend のオリジン（Hub「システム」導線の遷移先）。
# redirect_uris は reference *backend* の OIDC callback（global prefix /api/v1 配下）。
# reference 側 .env の OIDC_CLIENT_SECRET / OIDC_REDIRECT_URI と必ず一致させる。
# REFERENCE_APP_URL="http://localhost:3000"
# OIDC_REFERENCE_CLIENT_ID="struct-pass-reference"
# OIDC_REFERENCE_CLIENT_SECRET="set-a-random-client-secret-and-share-with-reference"
# OIDC_REFERENCE_REDIRECT_URIS="http://localhost:3001/api/v1/auth/oidc/callback"
# Hub「システム」導線（reference 連携）の有効化スイッチ。OIDC RP 連携が完成するまでは
# 未設定（=false）にして導線をグレー（準備中）に保つ。URL を設定しただけでは有効化されない。
# 連携が動作確認できたら "true" にしてタブを開放する。
# REFERENCE_OIDC_READY="false"
# reference backend の API ベース URL（hom-0067・ObjectType 種別一覧の proxy 先）。
# 未設定なら http://localhost:3001/api/v1。reference 側 PORT を変えた時は揃える。
# REFERENCE_INTEGRATION_API_URL="http://localhost:3001/api/v1"
# reference との機械認証用 共有 credential（hom-0067・service token・secret 扱い）。
# reference 側 .env の INTEGRATION_SERVICE_TOKEN と必ず一致させる（未設定なら proxy は空応答へ縮退）。
# 64 バイト hex を推奨: node -e "console.log(require('node:crypto').randomBytes(64).toString('hex'))"
# INTEGRATION_SERVICE_TOKEN="set-a-random-token-shared-with-reference"

# ============================================================
# トランザクショナルメール SMTP（招待 / 将来の通知。ADR 0035）
# ============================================================
# すべて任意。未設定なら MailService が「未設定」を返し、メール依存機能（招待）は
# graceful degradation で無効化される（アプリは起動を止めない・UI は「利用不可」を明示）。
# dev は docker-compose の Mailpit へ送る: SMTP_HOST=localhost / SMTP_PORT=1025（認証なし）。
# 送ったメールは Mailpit Web UI（http://localhost:8025）で実物を確認できる。
# 本番・譲渡先は自社 SMTP / Gmail 等の値を入れる（外部メール SaaS は採用しない＝ADR 0035）。
# SMTP_HOST="localhost"
# SMTP_PORT="1025"
# SMTP_SECURE="false"          # 465 番(SMTPS)を使う時のみ true
# SMTP_USER=""                 # 認証が要る SMTP の時だけ設定
# SMTP_PASS=""                 # secret。placeholder のみコミットし実値はコミットしない（§4）
# MAIL_FROM="no-reply@rete.local"  # 差出人。SMTP_HOST と本値が揃って初めてメール機能が有効になる

# ============================================================
# 招待機能（ST-5）
# ============================================================
# 招待リンクの base URL（frontend の公開 URL）。リンクは ${APP_PUBLIC_URL}/invite/accept?token=... 形式。
# 未設定なら http://localhost:3000 にフォールバックする。
# 譲渡先が 1 台で動かす場合の素直な値: http://localhost:3000
# 開発統括ローカル（rete frontend が 3010 番）: http://localhost:3010
# APP_PUBLIC_URL="http://localhost:3000"
