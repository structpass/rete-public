# Rete 本番用 環境変数テンプレート（cmn-0403）。
# サーバー上でこのファイルを .env.production にコピーして、実値を埋める（docs/architecture/deploy-setup.md §3）。
# NEVER commit the actual .env.production file to version control.

# ============================================================
# Domain（DDNS サブドメイン）
# ============================================================
# reference の共有 Caddy が TLS を終端し、このサブドメインを rete へ向ける。
# Caddyfile の {$RETE_DOMAIN} と一致させること。reference の DOMAIN とは別のサブドメインを採る
# （reference と同じ DDNS サービスで rete 用サブドメインを登録する・deploy-setup.md §前提）。
# 実ドメインはここに書かず、サーバー上の .env.production で埋める（公開検査の禁止対象・cmn-0407）。
DOMAIN=<rete 用サブドメイン>

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_USER=rete
POSTGRES_PASSWORD=<generate-with: openssl rand -hex 32>
POSTGRES_DB=rete_prod

# ============================================================
# Backend 必須 secret（main.ts の validateProductionSecrets が起動時に検査・欠落は fail-fast）
# ============================================================
SESSION_SECRET=<generate-with: openssl rand -hex 64>
OIDC_COOKIE_KEYS=<generate-with: openssl rand -hex 64>
OIDC_JWKS=<JSON: {"keys":[ ... ]}。未設定は起動時に fail-fast。rete が OIDC IdP として使う署名鍵>

# ============================================================
# Frontend build 時注入（Dockerfile の ARG）
# ============================================================
# NEXT_PUBLIC_API_BASE_URL は本ファイルでは設定しない＝compose が DOMAIN から
# `https://${DOMAIN}/api/v1` を導出して build arg に渡す（ここに書いても読まれない）。
# instruction-board の iframe 表示 URL（開発運用タブ・rete 独自）。本番では未使用なら空でも可（compose 側も空許容）。
NEXT_PUBLIC_INSTRUCTION_BOARD_URL=
# struct-pass-reference frontend のオリジン（システムタブの probe / 遷移先）。
NEXT_PUBLIC_REFERENCE_APP_URL=https://<reference の DOMAIN>
REFERENCE_APP_URL=https://<reference の DOMAIN>
REFERENCE_OIDC_READY=false

# ============================================================
# OIDC IdP（rete 自身 = Identity Provider）
# ============================================================
# issuer は compose が https://${DOMAIN}/api/v1/oidc として固定で組み立てる（本ファイルでは
# 設定不要・書いても compose は転送しないため上書きも効かない）。

# ============================================================
# struct-pass-reference 連携（OIDC RP）・seed 初期管理者
# ============================================================
# OIDC_REFERENCE_*（RP クライアント設定）は compose が backend へ転送済み（cmn-0423）なので、
# このファイルに書けば .env.production 経由で backend へ渡る。未設定なら空文字が渡り
# client 0 件 fail-closed のまま（SSO 無効で従来どおり起動）。実値の設定手順は
# docs/architecture/deploy-setup.md の本番登録手順を参照（reference 側 OIDC_* との一致要件あり）。
# SEED_ADMIN_*（初期管理者）は引き続き compose 転送対象外（経路は ref-0086 が担当）。

# ============================================================
# トランザクショナルメール SMTP（招待・将来の通知。ADR 0035・すべて任意）
# ============================================================
# 未設定なら MailService が「未設定」を返し、メール依存機能（招待）は graceful degradation で無効化。
# 設定する場合: SMTP_HOST と MAIL_FROM が揃って初めて有効化される。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=no-reply@rete.example.com

# ============================================================
# クロスサービス CORS（reference 連携・任意）
# ============================================================
# reference 画面から rete の表示設定 API を取りに来る通信の追加許可オリジン（reference の公開 URL）。
# 未設定なら追加許可なし＝クロスサービス通信を許可しない従来挙動（連携フェーズで設定する・cmn-0417）。
# CROSS_SERVICE_CORS_ORIGIN=

# reference の object-types proxy と共有する機械認証 credential（reference 側と同値）。
# INTEGRATION_SERVICE_TOKEN=
