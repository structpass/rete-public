diff --git a/lib/validate.js b/lib/validate.js
new file mode 100644
index 0000000000000000000000000000000000000000..30e24db018c875d0609ed4306ba73acb80d1ee4f
--- /dev/null
+++ b/lib/validate.js
@@ -0,0 +1,55 @@
+'use strict';
+
+// Bound structural recursion independently of maxLength/rangeLimit options.
+const MAX_DEPTH = 100;
+const depthError = () => new SyntaxError('Brace AST exceeds maximum structural depth (100)');
+const assertDepth = depth => { if (depth > MAX_DEPTH) throw depthError(); };
+const validateQueue = queue => {
+  const active = new Set();
+  const stack = [{ value: queue, depth: 0, exit: false }];
+  while (stack.length) {
+    const { value, depth, exit } = stack.pop();
+    if (typeof value === 'string' || typeof value === 'number') continue;
+    if (!Array.isArray(value)) throw new SyntaxError('Invalid brace AST queue');
+    if (exit) { active.delete(value); continue; }
+    if (active.has(value)) throw new SyntaxError('Cyclic brace AST queue');
+    assertDepth(depth);
+    active.add(value);
+    stack.push({ value, depth, exit: true });
+    for (let i = value.length - 1; i >= 0; i--) {
+      stack.push({ value: value[i], depth: depth + 1, exit: false });
+    }
+  }
+};
+const validateAst = ast => {
+  const active = new Set();
+  const stack = [{ node: ast, depth: 0, exit: false }];
+  while (stack.length) {
+    const { node, depth, exit } = stack.pop();
+    if (!node || typeof node !== 'object' || Array.isArray(node)) {
+      throw new SyntaxError('Invalid brace AST node');
+    }
+    if (exit) { active.delete(node); continue; }
+    if (active.has(node)) throw new SyntaxError('Cyclic brace AST nodes');
+    if (node.value !== undefined && typeof node.value !== 'string') {
+      throw new SyntaxError('Invalid brace AST value');
+    }
+    if (node.queue !== undefined) validateQueue(node.queue);
+    if (!node.nodes) continue;
+    assertDepth(depth);
+    if (!Array.isArray(node.nodes)) throw new SyntaxError('Invalid brace AST nodes');
+    active.add(node);
+    stack.push({ node, depth, exit: true });
+    for (let i = node.nodes.length - 1; i >= 0; i--) {
+      stack.push({ node: node.nodes[i], depth: depth + 1, exit: false });
+    }
+  }
+};
+const validateParent = (node, seen) => {
+  if (!node || typeof node !== 'object' || Array.isArray(node)) throw new SyntaxError('Invalid brace AST parent');
+  if (node.queue !== undefined) validateQueue(node.queue);
+  if (seen.has(node)) throw new SyntaxError('Cyclic brace AST parent');
+  seen.add(node);
+  assertDepth(seen.size - 1);
+};
+module.exports = { MAX_DEPTH, assertDepth, validateAst, validateParent };
